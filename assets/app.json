{
  "_comment": "DO NOT EDIT — Expo reads ../app.json at the project root. This file is a mirror only.",
  "expo": {
    "name": "Cozable",
    "slug": "cozable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "cozable",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./logo.png",
      "bundleIdentifier": "com.war85ren2.cozable",
      "infoPlist": {
        "NSCameraUsageDescription": "Cozable needs camera access to scan day-colour tray labels in real-time.",
        "NSMicrophoneUsageDescription": "Cozable needs microphone access when recording scan videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121316",
        "foregroundImage": "./logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.war85ren2.cozable",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
