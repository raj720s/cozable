+}
+#endif
+
+TfLiteDelegate* getXNNPackDelegate() {
+#if defined(ANDROID)
+  // One shared delegate — AddDelegate requires the pointer to outlive interpreters.
+  static TfLiteDelegate* delegate = TfLiteXNNPackDelegateCreate(nullptr);
