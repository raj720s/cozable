{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcons/AppIcon.icon",
      "bundleIdentifier": "com.war85ren2.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan day-colour tray labels in real-time.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to scan day-colour tray labels in real-time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/AppIcons/android/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.war85ren2.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/AppIcons/playstore.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/AppIcons/android/adaptive-foreground.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": [
            "libOpenCL.so",
            "libOpenGLES.so"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
